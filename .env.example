# Copy to .env.local and fill in. .env.local is gitignored.

# The Google account automations are authorized against. Authorization is
# rejected if consent is granted with any other account.
GOOGLE_ACCOUNT=you@example.com

# Mr. Green recycling pickup sync
MR_GREEN_ZIP=0000
MR_GREEN_PLAN=monthly
MR_GREEN_ATTENDEE=someone@example.com

# Opaque tag written to every event this automation owns, and the key it
# reconciles against. Changing it orphans existing events and recreates them.
MR_GREEN_EVENT_SOURCE=mr-green-0000-home-light
